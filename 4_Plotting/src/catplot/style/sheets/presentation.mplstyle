# Same visual language for larger on-screen panels.

figure.figsize: 4.7244094488, 4.7244094488
figure.dpi: 120

font.size: 11.0
axes.titlesize: 13.0
axes.titleweight: normal
axes.titlepad: 7.0
axes.labelsize: 12.0
axes.labelpad: 4.0
axes.linewidth: 1.1

lines.linewidth: 1.7
lines.markersize: 6.0
lines.markeredgewidth: 1.0
patch.linewidth: 1.0

xtick.labelsize: 10.5
ytick.labelsize: 10.5
xtick.major.size: 5.0
ytick.major.size: 5.0
xtick.major.width: 1.1
ytick.major.width: 1.1
xtick.major.pad: 3.5
ytick.major.pad: 3.5
xtick.minor.size: 3.0
ytick.minor.size: 3.0
xtick.minor.width: 0.8
ytick.minor.width: 0.8

legend.fontsize: 10.5
grid.linewidth: 0.7
grid.alpha: 0.35

